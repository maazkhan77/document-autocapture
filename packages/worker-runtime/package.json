{
  "name": "@docuscan/worker-runtime",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format esm --out-dir dist --dts --splitting false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@docuscan/core-engine": "workspace:*",
    "@docuscan/ml-tf-fallback": "workspace:*"
  }
}
